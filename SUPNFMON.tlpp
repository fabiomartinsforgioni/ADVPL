        "Valor da NF", {|| (cAlias)->F2_VALBRUT}, "N",;
        TamSx3("F2_VALBRUT")[1], TamSx3("F2_VALBRUT")[2],;
        "@E 999,999,999.99";
    ))

Return aColumns

/*/{Protheus.doc} AddIntegrationColumns
Adiciona as informacoes de controle da integracao Mais Vendas.

@param aColumns, Array, Colunas ja configuradas
@param cAlias, Character, Alias da consulta
@type static function
@author Fabio
@since 03/08/2026
@version 1.0
@return Array, Colunas atualizadas
/*/
Static Function AddIntegrationColumns(aColumns, cAlias)

    aAdd(aColumns, NewColumn(;
        "Limite de Entrega", {|| StoD((cAlias)->SUP_DTLENT)},;
        "D", 8, 0, "@D";
    ))
    aAdd(aColumns, NewColumn(;
        "Código da Implantação", {|| (cAlias)->SUP_CODINV},;
        "C", 8, 0, "@!";
    ))
    aAdd(aColumns, NewColumn(;
        "Código da Transação", {|| (cAlias)->SUP_CODTRA},;
        "C", 20, 0, "@!";
    ))

Return aColumns

/*/{Protheus.doc} AddBrowseLegends
Configura as legendas funcionais do monitor.

@param oBrowse, Object, Browse de notas fiscais
@type static function
@author Fabio
@since 03/08/2026
@version 1.0
@return Nil
/*/
Static Function AddBrowseLegends(oBrowse)

    oBrowse:AddLegend(;
        "LEGSTATUS == 'O'",;
        "BR_VERDE",;
        "Tudo OK: faturamento e financeiro processados";
    )
    oBrowse:AddLegend(;
        "LEGSTATUS == 'E'",;
        "BR_VERMELHO",;
        "Erro no faturamento ou no financeiro";
    )
    oBrowse:AddLegend(;
        "LEGSTATUS == 'C'",;
        "BR_CINZA",;
        "Nota cancelada ou excluída";
    )
    oBrowse:AddLegend(;
        "LEGSTATUS == 'P'",;
        "BR_AMARELO",;
        "Pendente, aguardando envio, entrega ou implantação";
    )

Return Nil

/*/{Protheus.doc} AddBrowseButtons
Configura as acoes disponiveis na barra do monitor.

@param oBrowse, Object, Browse de notas fiscais
@param oModal, Object, Janela principal do monitor
@param cBranch, Character, Filial atualmente exibida
@param dDateFrom, Date, Data inicial do periodo
@param dDateTo, Date, Data final do periodo
@param cStatusFilter, Character, Situacao funcional selecionada
@type static function
@author Fabio
@since 03/08/2026
@version 1.0
@return Nil
/*/
Static Function AddBrowseButtons(oBrowse, oModal, cBranch, dDateFrom, dDateTo, cStatusFilter)

    oBrowse:AddButton(;
        "Filtros",;
        {|| ChangeFilters(;
            oBrowse,;
            oModal,;
            cBranch,;
            @dDateFrom,;
            @dDateTo,;
            @cStatusFilter;
        )},;
        ,,,;
        .F.;
    )
    oBrowse:AddButton(;
        "Trocar Filial",;
        {|| cBranch := ChangeBranch(;
            oBrowse,;
            oModal,;
            cBranch,;
            dDateFrom,;
            dDateTo,;
            cStatusFilter;
        )},;
        ,,,;
        .F.;
    )
    oBrowse:AddButton(;
        "Atualizar",;
        {|| RefreshBrowse(;
            oBrowse,;
            cBranch,;
            dDateFrom,;
            dDateTo,;
            cStatusFilter;
        )},;
        ,,,;
        .F.;
    )
    oBrowse:AddButton("Legenda", {|| ShowLegendHelp()},,,,.F.)

Return Nil

/*/{Protheus.doc} ChangeFilters
Permite alterar o periodo e a situacao sem reabrir o monitor.

Datas vazias consultam o historico completo. A consulta somente e atualizada
quando os parametros informados forem validos.

@param oBrowse, Object, Browse de notas fiscais
@param oModal, Object, Janela principal do monitor
@param cBranch, Character, Filial atualmente exibida
@param dDateFrom, Date, Data inicial do periodo
@param dDateTo, Date, Data final do periodo
@param cStatusFilter, Character, Situacao funcional selecionada
@type static function
@author Fabio
@since 03/08/2026
@version 1.0
@return Logical, Indica se os filtros foram aplicados
/*/
Static Function ChangeFilters(oBrowse, oModal, cBranch, dDateFrom, dDateTo, cStatusFilter)

    Local aParams        := {}                                                  as Array
    Local aResult        := {}                                                  as Array
    Local aStatusOptions := {;
        FILTER_ALL,;
        FILTER_ERROR,;
        FILTER_PENDING,;
        FILTER_PROCESSED,;
        FILTER_CANCELED;
    }                                                                           as Array

    aAdd(aParams, {;
        1, "Emissão de (vazio = histórico)", dDateFrom, "", "", "", "", 100, .T.;
    })
    aAdd(aParams, {;
        1, "Emissão até (vazio = histórico)", dDateTo, "", "", "", "", 100, .T.;
    })
    aAdd(aParams, {;
        2, "Situação", cStatusFilter, aStatusOptions, 100, ".T.", .T.;
    })

    If !ParamBox(aParams, "Filtros do Monitor", @aResult, {|| .T.})
        Return .F.
    EndIf

    If !Empty(aResult[1]) .And. !Empty(aResult[2])
        If aResult[1] > aResult[2]
            FWAlertInfo(;
                "A data inicial não pode ser maior que a data final.",;
                "Filtros do Monitor";
            )

            Return .F.
        EndIf
    EndIf

    dDateFrom            := aResult[1]
    dDateTo              := aResult[2]
    cStatusFilter        := aResult[3]

    RefreshBrowse(;
        oBrowse,;
        cBranch,;
        dDateFrom,;
        dDateTo,;
        cStatusFilter;
    )
    oModal:SetTitle(GetMonitorTitle(;
        cBranch,;
        dDateFrom,;
        dDateTo,;
        cStatusFilter;
    ))

Return .T.

/*/{Protheus.doc} ChangeBranch
Permite selecionar uma filial autorizada e atualiza os dados do monitor.

A troca afeta apenas a consulta desta tela. A filial do ambiente Protheus
permanece inalterada e os filtros atuais sao preservados.

@param oBrowse, Object, Browse de notas fiscais
@param oModal, Object, Janela principal do monitor
@param cBranch, Character, Filial atualmente exibida
@param dDateFrom, Date, Data inicial do periodo
@param dDateTo, Date, Data final do periodo
@param cStatusFilter, Character, Situacao funcional selecionada
@type static function
@author Fabio
@since 30/07/2026
@version 1.1
@return Character, Filial que permanece selecionada no monitor
/*/
Static Function ChangeBranch(oBrowse, oModal, cBranch, dDateFrom, dDateTo, cStatusFilter)

    Local aBranches      := FwListBranches(;
        .T.,;
        .F.,;
        .T.,;
        { "SM0_CODFIL", "SM0_NOMRED" };
    )                                                                           as Array
    Local cNewBranch     := cBranch                                             as Character

    If Empty(aBranches)
        Return cBranch
    EndIf

    If Len(aBranches) != 1
        FWAlertInfo(;
            "Selecione somente uma filial para visualizar no monitor.",;
            "Trocar Filial";
        )

        Return cBranch
    EndIf

    If ValType(aBranches[1]) != "A" .Or. Len(aBranches[1]) < 1
        FWAlertError(;
            "Não foi possível identificar a filial selecionada.",;
            "Trocar Filial";
        )

        Return cBranch
    EndIf

    cNewBranch           := AllTrim(aBranches[1][1])

    If Empty(cNewBranch) .Or. cNewBranch == AllTrim(cBranch)
        Return cBranch
    EndIf

    RefreshBrowse(;
        oBrowse,;
        cNewBranch,;
        dDateFrom,;
        dDateTo,;
        cStatusFilter;
    )
    oModal:SetTitle(GetMonitorTitle(;
        cNewBranch,;
        dDateFrom,;
        dDateTo,;
        cStatusFilter;
    ))

Return cNewBranch

/*/{Protheus.doc} RefreshBrowse
Reconstroi a consulta e atualiza o browse preservando os filtros atuais.

@param oBrowse, Object, Browse de notas fiscais
@param cBranch, Character, Filial atualmente exibida
@param dDateFrom, Date, Data inicial do periodo
@param dDateTo, Date, Data final do periodo
@param cStatusFilter, Character, Situacao funcional selecionada
@type static function
@author Fabio
@since 03/08/2026
@version 1.0
@return Nil
/*/
Static Function RefreshBrowse(oBrowse, cBranch, dDateFrom, dDateTo, cStatusFilter)

    Local oError         := Nil                                                 as Object

    CursorWait()

    Try
        oBrowse:SetQuery(BuildQuery(;
            "",;
            cBranch,;
            dDateFrom,;
            dDateTo,;
            cStatusFilter;
        ))
        oBrowse:Refresh(.T.)
    Catch oError
        UserException(;
            "Não foi possível atualizar os dados do monitor: " +;
            AllTrim(oError:Description);
        )
    Finally
        CursorArrow()
    EndTry

Return Nil

/*/{Protheus.doc} GetMonitorTitle
Monta o titulo da janela com filial, periodo e situacao exibidos.

@param cBranch, Character, Filial atualmente exibida
@param dDateFrom, Date, Data inicial do periodo
@param dDateTo, Date, Data final do periodo
@param cStatusFilter, Character, Situacao funcional selecionada
@type static function
@author Fabio
@since 30/07/2026
@version 1.1
@return Character, Titulo completo da janela
/*/
Static Function GetMonitorTitle(cBranch, dDateFrom, dDateTo, cStatusFilter)

Return "Monitor Mais Vendas | Filial " + AllTrim(cBranch) + " | " +;
    GetPeriodDescription(dDateFrom, dDateTo) + " | " + cStatusFilter +;
    " | " + GetSourceBuild()

/*/{Protheus.doc} GetPeriodDescription
Retorna a descricao do periodo atualmente consultado.

@param dDateFrom, Date, Data inicial do periodo
@param dDateTo, Date, Data final do periodo
@type static function
@author Fabio
@since 03/08/2026
@version 1.0
@return Character, Descricao amigavel do periodo
/*/
Static Function GetPeriodDescription(dDateFrom, dDateTo)

    Local cDescription   := "Todo o histórico"                                 as Character

    If !Empty(dDateFrom) .And. !Empty(dDateTo)
        cDescription         := DToC(dDateFrom) + " a " + DToC(dDateTo)
    ElseIf !Empty(dDateFrom)
        cDescription         := "Desde " + DToC(dDateFrom)
    ElseIf !Empty(dDateTo)
        cDescription         := "Até " + DToC(dDateTo)
    EndIf

Return cDescription

/*/{Protheus.doc} ShowLegendHelp
Apresenta a traducao completa das cores utilizadas no monitor.

@type static function
@author Fabio
@since 27/07/2026
@version 3.0
@return Nil
/*/
Static Function ShowLegendHelp()

    Local aLegend        := {;
        { "BR_VERDE", "Tudo OK - faturamento e financeiro processados." },;
        { "BR_VERMELHO", "Erro no faturamento ou no processamento financeiro." },;
        { "BR_CINZA", "Nota cancelada ou excluída." },;
        { "BR_AMARELO", "Aguardando envio, entrega, financeiro ou implantação." };
    }                                                                           as Array

    BrwLegenda("Monitor Mais Vendas", "Legenda", aLegend)

Return Nil

/*/{Protheus.doc} NewColumn
Cria e configura uma coluna para o browse do monitor.

@param cTitle, Character, Titulo apresentado no cabecalho
@param bData, CodeBlock, Bloco que retorna o conteudo da coluna
@param cType, Character, Tipo do dado
@param nSize, Numeric, Tamanho do campo
@param nDecimal, Numeric, Quantidade de casas decimais
@param cPicture, Character, Mascara de apresentacao
@type static function
@author Fabio
@since 27/07/2026
@version 1.0
@return Object, Coluna configurada
/*/
Static Function NewColumn(cTitle, bData, cType, nSize, nDecimal, cPicture)

    Local oColumn        := Nil                                                 as Object

    oColumn              := FWBrwColumn():New()

    oColumn:SetTitle(cTitle)
    oColumn:SetData(bData)
    oColumn:SetType(cType)
    oColumn:SetSize(nSize)
    oColumn:SetDecimal(nDecimal)

    If !Empty(cPicture)
        oColumn:SetPicture(cPicture)
    EndIf

Return oColumn

/*/{Protheus.doc} GetStatus
Retorna a descricao do status da nota fiscal no fluxo Mais Vendas.

A ordem das validacoes representa a precedencia funcional dos status.

@param cAlias, Character, Alias posicionado na nota fiscal
@type static function
@author Fabio
@since 27/07/2026
@version 3.0
@return Character, Descricao do status
/*/
Static Function GetStatus(cAlias)

    Local cResult        := "Status nao mapeado"                                as Character
    Local cStatus        := AllTrim((cAlias)->SUP_STATUS)                       as Character
    Local cProcFin       := AllTrim((cAlias)->SUP_PROCFI)                       as Character
    Local cConEnt        := AllTrim((cAlias)->SUP_CONENT)                       as Character

    // Sem registro na SUPPAYINVOICE, a nota ainda nao foi implantada.
    If Empty((cAlias)->RECINV)
        cResult              := "Não implantada"

    // Situacoes encerradas possuem prioridade sobre o financeiro.
    ElseIf cStatus == "2" .Or. cStatus == "4" .Or. cStatus == "5"
        cResult              := "Cancelada/Excluída"

    // Erro ocorrido durante o faturamento.
    ElseIf cStatus == "X"
        cResult              := "Erro no faturamento"

    // A API solicitou uma nova tentativa posterior.
    ElseIf cStatus == "T"
        cResult              := "Aguardando Supplier"

    // Registro criado, mas ainda nao enviado ao Mais Vendas.
    ElseIf cStatus == "0"
        cResult              := "Aguardando envio"

    // Cliente DDE aguardando a confirmacao da entrega.
    ElseIf cStatus == "1" .And. cConEnt == "X" .And. Empty((cAlias)->SUP_DATENT)
        cResult              := "DDE - Aguardando entrega"

    // Faturamento processado e financeiro ainda pendente.
    ElseIf cStatus == "1" .And. (cProcFin == "0" .Or. Empty(cProcFin))
        cResult              := "Aguardando financeiro"

    // Faturamento processado e financeiro com erro.
    ElseIf cStatus == "1" .And. cProcFin == "2"
        cResult              := "Erro no financeiro"

    // Implantacao concluida no faturamento e no financeiro.
    ElseIf cStatus == "1" .And. cProcFin == "1"
        cResult              := "Implantada"
    Else
        cResult              := "Não mapeado (" + cStatus + ")"
    EndIf

Return cResult

/*/{Protheus.doc} GetBillingStatus
Traduz o codigo tecnico do faturamento para uma descricao funcional.

@param cAlias, Character, Alias posicionado na nota fiscal
@type static function
@author Fabio
@since 27/07/2026
@version 3.0
@return Character, Descricao do status do faturamento
/*/
Static Function GetBillingStatus(cAlias)

    Local cResult        := "Status nao mapeado"                                as Character
    Local cStatus        := AllTrim((cAlias)->SUP_STATUS)                       as Character

    If Empty((cAlias)->RECINV)
        cResult              := "Não implantado"
    ElseIf Empty(cStatus)
        cResult              := "Não iniciado"
    ElseIf cStatus == "0"
        cResult              := "Aguardando envio"
    ElseIf cStatus == "1"
        cResult              := "Processado"
    ElseIf cStatus == "2"
        cResult              := "Cancelado"
    ElseIf cStatus == "4"
        cResult              := "Excluído"
    ElseIf cStatus == "5"
        cResult              := "Cancelado/Excluído"
    ElseIf cStatus == "T"
        cResult              := "Aguardando Supplier"
    ElseIf cStatus == "X"
        cResult              := "Erro"
    Else
        cResult              := "Não mapeado (" + cStatus + ")"
    EndIf

Return cResult

/*/{Protheus.doc} GetFinancialStatus
Traduz o codigo tecnico do financeiro para uma descricao funcional.

@param cAlias, Character, Alias posicionado na nota fiscal
@type static function
@author Fabio
@since 27/07/2026
@version 3.0
@return Character, Descricao do status do financeiro
/*/
Static Function GetFinancialStatus(cAlias)

    Local cResult        := "Status nao mapeado"                                as Character
    Local cProcFin       := AllTrim((cAlias)->SUP_PROCFI)                       as Character

    If Empty((cAlias)->RECINV)
        cResult              := "Não implantado"
    ElseIf Empty(cProcFin)
        cResult              := "Não iniciado"
    ElseIf cProcFin == "0"
        cResult              := "Aguardando"
    ElseIf cProcFin == "1"
        cResult              := "Processado"
    ElseIf cProcFin == "2"
        cResult              := "Erro"
    Else
        cResult              := "Não mapeado (" + cProcFin + ")"
    EndIf

Return cResult
